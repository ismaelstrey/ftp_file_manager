generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = "file:./data.db"
}

model MonitoredDirectory {
    id        Int      @id @default(autoincrement())
    path      String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Task {
    id           Int       @id @default(autoincrement())
    title        String
    description  String
    isContinuous Boolean   @default(false)
    status       String    @default("pending")
    dueDate      DateTime?
    completedAt  DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
}

model FtpServer {
    id            Int         @id @default(autoincrement())
    name          String?
    host          String
    port          Int         @default(21)
    username      String
    password      String
    active        Boolean     @default(false)
    createdAt     DateTime    @default(now())
    ftpDirectory  String?
    ftp_empresa   FtpEmpresa? @relation(fields: [ftp_empresaId], references: [id])
    ftp_empresaId Int?
}

model FtpEmpresa {
    id         Int         @id @default(autoincrement())
    active     Boolean?    @default(true)
    name       String
    createdAt  DateTime?   @default(now())
    ftp_server FtpServer[]
}

model Comando {
    id        Int      @id @default(autoincrement())
    name      String
    command   String
    type      String
    olt       String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
